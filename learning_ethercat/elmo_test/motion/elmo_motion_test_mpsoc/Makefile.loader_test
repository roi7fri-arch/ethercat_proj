# Host build for the standalone config-loader smoke test (no SOEM/EtherCAT).
CC ?= cc
CFLAGS ?= -Wall -Wextra -O2

config_loader_test: config_loader_test.c config_loader.c cJSON.c
	$(CC) $(CFLAGS) -o $@ config_loader_test.c config_loader.c cJSON.c

telemetry_test: telemetry_test.c telemetry.c config_loader.c cJSON.c
	$(CC) $(CFLAGS) -o $@ telemetry_test.c telemetry.c config_loader.c cJSON.c

.PHONY: clean
clean:
	rm -f config_loader_test telemetry_test
